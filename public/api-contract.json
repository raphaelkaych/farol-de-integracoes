                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "iniciar"
                      },
                      "scenario": {
                        "type": "string",
                        "enum": [
                          "instavel",
                          "indisponivel"
                        ]
                      }
                    },
                    "required": [
                      "action",
                      "scenario"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": [
                          "enviar-1042",
                          "enviar-1047",
                          "enviar-1051",
