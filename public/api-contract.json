    "/api/traceatlas": {
      "post": {
        "summary": "Gerar rastros simulados e medir a sonda do banco",
        "description": "O lote usa tempos determinísticos. A sonda mede uma consulta real ao D1. O corpo aceita até 1 KiB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scenario": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "db-lento",
                      "db-fora",
                      "worker",
                      "erp",
                      "recuperacao"
                    ]
                  }
                },
                "required": [
                  "scenario"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lote de rastros e resultado da sonda",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlação do lote",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceAtlasRun"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Tamanho máximo excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dados fora do contrato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DemoSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Identificador e segredo da sessão de demonstração."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Código opcional para tratamento programático."
          }
        },
        "required": [
          "error"
        ]
      },
      "QualityComparison": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "stock",
              "replay",
              "role"
            ]
          },
          "input": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "type": "string",
                "enum": [
                  "operador",
                  "leitor"
                ]
              }
            },
            "required": [
              "ref",
              "quantity",
              "role"
            ]
          },
          "invariant": {
            "type": "string"
          },
          "control": {
            "type": "object",
            "properties": {
              "responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200,
                        201,
                        403,
                        409,
                        422
                      ]
                    },
                    "reason": {
                      "type": "string"
                    },
                    "receipt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "reason"
                  ]
                }
              },
              "inventory": {
                "type": "object",
                "properties": {
                  "available": {
                    "type": "integer"
                  },
                  "receipts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "ref": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "id",
                        "ref",
                        "quantity"
                      ]
                    }
                  }
                },
                "required": [
                  "available",
                  "receipts"
                ]
              },
              "conforms": {
                "type": "boolean"
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "expected",
                    "actual",
                    "passed"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "actual": {
                      "type": "string"
                    },
                    "passed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "required": [
              "responses",
              "inventory",
              "conforms"
            ]
          },
          "injected": {
            "type": "object",
            "properties": {
              "responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200,
                        201,
                        403,
                        409,
                        422
                      ]
                    },
                    "reason": {
                      "type": "string"
                    },
                    "receipt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "reason"
                  ]
                }
              },
              "inventory": {
                "type": "object",
                "properties": {
                  "available": {
                    "type": "integer"
                  },
                  "receipts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "ref": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "id",
                        "ref",
                        "quantity"
                      ]
                    }
                  }
                },
                "required": [
                  "available",
                  "receipts"
                ]
              },
              "conforms": {
                "type": "boolean"
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "expected",
                    "actual",
                    "passed"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "actual": {
                      "type": "string"
                    },
                    "passed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "required": [
              "responses",
              "inventory",
              "conforms"
            ]
          }
        },
        "required": [
          "scenario",
          "input",
          "invariant",
          "control",
          "injected"
        ]
      },
      "LedgerEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "pattern": "^LF-[0-9]{4,6}$"
          },
          "origin": {
            "type": "string",
            "enum": [
              "banco",
              "sistema"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999
          },
