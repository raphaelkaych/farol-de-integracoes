{
  "openapi": "3.1.0",
  "info": {
    "title": "Laboratórios de engenharia de Raphael Kaych",
    "version": "2.1.0",
    "description": "Contrato HTTP dos laboratórios de demonstração com dados fictícios."
  },
  "servers": [
    {
      "url": "https://raphael-kaych.raphaelvindex.chatgpt.site"
    }
  ],
  "paths": {
    "/api/qualitygate": {
      "post": {
        "summary": "Comparar a regra de estoque com uma falha injetada",
        "description": "O HTTP 200 indica que o experimento foi executado. Os códigos dentro do resultado pertencem às duas execuções isoladas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scenario": {
                    "type": "string",
                    "enum": [
                      "stock",
                      "replay",
                      "role"
                    ]
                  }
                },
                "required": [
                  "scenario"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comparação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityComparison"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Tamanho máximo excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dados fora do contrato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/ledgerflow": {
      "get": {
        "summary": "Consultar a sessão e as últimas operações",
        "security": [
          {
            "DemoSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Estado da sessão",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "$ref": "#/components/schemas/LedgerState"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Token ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Sessão ausente ou expirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Armazenamento indisponível ou limite de sessões atingido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Abrir sessão ou alterar lançamentos",
        "description": "A abertura é pública. As ações exigem token e perfil analista. O CSV aceita somente campos do formato da demonstração.",
        "security": [
          {},
          {
            "DemoSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "iniciar"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "analista",
                          "leitor"
                        ]
                      }
                    },
                    "required": [
                      "action",
                      "role"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "importar"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "csv": {
                        "type": "string",
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "action",
                      "version",
                      "csv"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "conciliar"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60
                      }
                    },
                    "required": [
                      "action",
                      "version"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "criar"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "reference": {
                        "type": "string",
                        "pattern": "^LF-[0-9]{4,6}$"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "banco",
                          "sistema"
                        ]
                      },
                      "date": {
                        "type": "string",
                        "format": "date"
                      },
                      "cents": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99999999
                      }
                    },
                    "required": [
                      "action",
                      "version",
                      "reference",
                      "origin",
                      "date",
                      "cents"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "atualizar"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "id": {
                        "type": "string"
                      },
                      "reference": {
                        "type": "string",
                        "pattern": "^LF-[0-9]{4,6}$"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "banco",
                          "sistema"
                        ]
                      },
                      "date": {
                        "type": "string",
                        "format": "date"
                      },
                      "cents": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99999999
                      }
                    },
                    "required": [
                      "action",
                      "version",
                      "id",
                      "reference",
                      "origin",
                      "date",
                      "cents"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "const": "remover"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "action",
                      "version",
                      "id"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ação registrada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "$ref": "#/components/schemas/LedgerState"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Sessão criada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "$ref": "#/components/schemas/LedgerState"
                    },
                    "token": {
                      "type": "string",
                      "description": "Token temporário devolvido uma vez na abertura da sessão."
                    }
                  },
                  "required": [
                    "state",
                    "token"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Perfil leitor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Sessão ausente ou expirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revisão ou lançamento em conflito",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "$ref": "#/components/schemas/LedgerState"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Tamanho máximo excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dados fora do contrato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Armazenamento indisponível ou limite de sessões atingido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/farol": {
      "get": {
        "summary": "Consultar fila, relógio e histórico",
        "security": [
          {
            "DemoSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Estado atual",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "$ref": "#/components/schemas/FarolState"
                    }
                  },
                  "required": [
